module Bitflyer
  module HTTP
    BASE_URL: String
    MAX_RESPONSE_BODY_BYTES: Integer
    REQUEST_TIMEOUT: Integer

    module IdPagination
      DEFAULT_MAX_PAGES: Integer

      def self.stream: (Integer? before, Integer max_pages, ?on_each: (^(untyped) -> void)?) { (Integer?) -> untyped } -> (Enumerator[untyped, untyped] | nil)

      private def self.advance_page: (Enumerator::Yielder yielder, Integer? cursor) { () -> untyped } -> Integer?

      private def self.validate_page_budget: (Integer max_pages) -> void
    end

    class Response < Struct[untyped]
      attr_accessor body: untyped

      def self.new: (untyped body) -> instance
    end

    class ResponseError < StandardError
      attr_reader status: Integer
      attr_reader body: String?

      def initialize: (Integer status, String? body) -> void
    end

    class ResponseTooLargeError < StandardError
      def initialize: () -> void
    end

    class RequestTimeoutError < Timeout::Error
    end

    class Connection
      @key: String?
      @secret: String?
      @uri: URI::Generic
      @mutex: Thread::Mutex
      @http: Net::HTTP?

      def initialize: (String? key, String? secret) -> void

      def close: () -> void

      def inspect: () -> String

      def get: (String path, ?Hash[Symbol, untyped] params) -> Response

      def post: (String path, ?Hash[Symbol, untyped] body) -> Response

      private

      def default_headers: () -> Hash[String, String]

      def sign_request: (Net::HTTPRequest request, String path, ?String? body) -> void

      def execute: (Net::HTTPRequest request) -> Response

      def send_request: (Net::HTTPRequest request) -> Net::HTTPResponse

      def request_with_retry: (Net::HTTP http, Net::HTTPRequest request) -> Net::HTTPResponse

      def read_response_body: (Net::HTTPResponse response) -> String?

      def close_session: () -> void

      def parse_body: (String? body) -> untyped
    end
  end
end
