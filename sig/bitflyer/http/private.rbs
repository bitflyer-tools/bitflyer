module Bitflyer
  module HTTP
    module Private
      class Client
        @connection: Connection

        def initialize: (String key, String secret) -> void

        def permissions: () -> untyped

        def balance: () -> untyped

        def collateral: () -> untyped

        def addresses: () -> untyped

        def coin_ins: () -> untyped

        def coin_outs: () -> untyped

        def bank_accounts: () -> untyped

        def deposits: () -> untyped

        def withdraw: (
          ?currency_code: String,
          ?bank_account_id: Integer?,
          ?amount: Numeric?,
          ?code: String?
        ) -> untyped

        def withdrawals: () -> untyped

        def send_child_order: (
          ?product_code: String,
          ?child_order_type: String?,
          ?side: String?,
          ?price: Numeric?,
          ?size: Numeric?,
          ?minute_to_expire: Integer?,
          ?time_in_force: String
        ) -> untyped

        def cancel_child_order: (
          ?product_code: String,
          ?child_order_id: String?,
          ?child_order_acceptance_id: String?
        ) -> untyped

        def send_parent_order: (
          ?order_method: String?,
          ?minute_to_expire: Integer?,
          ?time_in_force: String,
          ?parameters: Array[Hash[Symbol, untyped]] | Hash[Symbol, untyped]
        ) -> untyped

        def cancel_parent_order: (
          ?product_code: String,
          ?parent_order_id: String?,
          ?parent_order_acceptance_id: String?
        ) -> untyped

        def cancel_all_child_orders: (?product_code: String) -> untyped

        def child_orders: (
          ?product_code: String,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?child_order_state: String?,
          ?parent_order_id: String?
        ) -> untyped

        def parent_orders: (
          ?product_code: String,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?parent_order_state: String?
        ) -> untyped

        def parent_order: (?parent_order_id: String?, ?parent_order_acceptance_id: String?) -> untyped

        def executions: (
          ?product_code: String,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?child_order_id: String?,
          ?child_order_acceptance_id: String?
        ) -> untyped

        def balance_history: (?currency_code: String?, ?count: Integer?, ?before: Integer?, ?after: Integer?) -> untyped

        def positions: (?product_code: String) -> untyped

        def trading_commission: (?product_code: String) -> untyped
      end
    end
  end
end
