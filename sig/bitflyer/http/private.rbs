module Bitflyer
  module HTTP
    module Private
      class Client
        PARENT_ORDER_REQUIRED_FIELDS: Array[String]
        PARENT_ORDER_CONDITION_FIELDS: Hash[String, Array[String]]

        @connection: Connection

        def initialize: (String key, String secret) -> void

        def close: () -> void

        def inspect: () -> String

        def permissions: () -> untyped

        def balance: () -> untyped

        def collateral: () -> untyped

        def collateral_history: (?count: Integer?, ?before: Integer?, ?after: Integer?) -> untyped

        def addresses: () -> untyped

        def coin_ins: (?count: Integer?, ?before: Integer?, ?after: Integer?) -> untyped

        def coin_outs: (?count: Integer?, ?before: Integer?, ?after: Integer?) -> untyped

        def bank_accounts: () -> untyped

        def deposits: (?count: Integer?, ?before: Integer?, ?after: Integer?) -> untyped

        # Amount accepts Integer or finite Float.
        def withdraw: (
          bank_account_id: Integer,
          amount: Integer | Float,
          ?currency_code: String,
          ?code: String?
        ) -> untyped

        def withdrawals: (?count: Integer?, ?before: Integer?, ?after: Integer?, ?message_id: String?) -> untyped

        def send_child_order: (
          child_order_type: String,
          side: String,
          size: Integer | Float,
          ?product_code: String,
          ?price: (Integer | Float)?,
          ?minute_to_expire: Integer?,
          ?time_in_force: String
        ) -> untyped

        def cancel_child_order: (
          ?product_code: String,
          child_order_id: String,
          ?child_order_acceptance_id: nil
        ) -> untyped
                                | (
          ?product_code: String,
          ?child_order_id: nil,
          child_order_acceptance_id: String
        ) -> untyped

        # Each condition requires non-nil product_code, condition_type, side, and size.
        # LIMIT and STOP_LIMIT require price, STOP and STOP_LIMIT require trigger_price,
        # and TRAIL requires offset. Keys may be symbols or strings.
        # Condition sizes, prices, and trigger prices accept Integer or finite Float. Offsets accept Integer.
        def send_parent_order: (
          parameters: Array[Hash[Symbol, untyped] | Hash[String, untyped]],
          ?order_method: String?,
          ?minute_to_expire: Integer?,
          ?time_in_force: String
        ) -> untyped

        def cancel_parent_order: (
          ?product_code: String,
          parent_order_id: String,
          ?parent_order_acceptance_id: nil
        ) -> untyped
                                 | (
          ?product_code: String,
          ?parent_order_id: nil,
          parent_order_acceptance_id: String
        ) -> untyped

        def cancel_all_child_orders: (?product_code: String) -> untyped

        def child_orders: (
          ?product_code: String,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?child_order_state: String?,
          ?parent_order_id: String?,
          ?child_order_id: String?,
          ?child_order_acceptance_id: String?
        ) -> untyped

        def parent_orders: (
          ?product_code: String,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?parent_order_state: String?
        ) -> untyped

        def parent_order: (parent_order_id: String, ?parent_order_acceptance_id: nil) -> untyped
                        | (?parent_order_id: nil, parent_order_acceptance_id: String) -> untyped

        def executions: (
          ?product_code: String,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?child_order_id: String?,
          ?child_order_acceptance_id: String?
        ) -> untyped

        def each_execution: (
          ?product_code: String,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?child_order_id: String?,
          ?child_order_acceptance_id: String?,
          ?max_pages: Integer
        ) -> Enumerator[untyped, untyped]
                          | (
          ?product_code: String,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?child_order_id: String?,
          ?child_order_acceptance_id: String?,
          ?max_pages: Integer
        ) { (untyped) -> void } -> nil

        def balance_history: (?currency_code: String?, ?count: Integer?, ?before: Integer?, ?after: Integer?) -> untyped

        def each_balance_history: (
          ?currency_code: String?,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?max_pages: Integer
        ) -> Enumerator[untyped, untyped]
                                | (
          ?currency_code: String?,
          ?count: Integer?,
          ?before: Integer?,
          ?after: Integer?,
          ?max_pages: Integer
        ) { (untyped) -> void } -> nil

        def positions: (?product_code: String) -> untyped

        def trading_commission: (?product_code: String) -> untyped

        private

        def order_identifier: (**String?) -> Hash[Symbol, String]

        def validate_parent_order_condition: (Hash[untyped, untyped] condition) -> void

        def validate_order_numbers: (Hash[untyped, untyped] fields) -> void

        def json_number?: (untyped value) -> bool
      end
    end
  end
end
