module Bitflyer
  module HTTP
    module Private
      class ParentOrderValidator
        PARENT_ORDER_CONDITION_COUNTS: Hash[String, Integer]
        PARENT_ORDER_REQUIRED_FIELDS: Array[String]
        PARENT_ORDER_CONDITION_FIELDS: Hash[String, Array[String]]

        def self.validate_parent_order_condition_count: (String order_method, Integer count) -> void

        def self.normalize_parent_order_condition: (Hash[Symbol | String, untyped] condition) -> Hash[String, untyped]

        def self.validate_parent_order_condition: (Hash[String, untyped] fields) -> void

        def self.validate_order_numbers: (Hash[untyped, untyped] fields) -> void

        def self.json_number?: (untyped value) -> bool
      end
    end
  end
end
