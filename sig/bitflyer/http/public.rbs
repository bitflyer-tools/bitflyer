module Bitflyer
  module HTTP
    module Public
      class Client
        @connection: Connection

        def initialize: () -> void

        def close: () -> void

        def health: (?product_code: String?) -> untyped

        def markets: () -> untyped

        def board: (?product_code: String) -> untyped

        def ticker: (?product_code: String) -> untyped

        def board_state: (?product_code: String) -> untyped

        def funding_rate: (product_code: String) -> untyped

        def funding_rate_history: (product_code: String, ?from: String?, ?to: String?, ?count: Integer?) -> untyped

        def executions: (?product_code: String, ?count: Integer?, ?before: Integer?, ?after: Integer?) -> untyped

        def each_execution: (
          ?product_code: String, ?count: Integer?, ?before: Integer?, ?after: Integer?, ?max_pages: Integer
        ) -> Enumerator[untyped, untyped]
                          | (
          ?product_code: String, ?count: Integer?, ?before: Integer?, ?after: Integer?, ?max_pages: Integer
        ) { (untyped) -> void } -> nil

        def chats: (?from_date: Time | String) -> untyped

        private

        def format_from_date: (Time | String from_date) -> String
      end
    end
  end
end
