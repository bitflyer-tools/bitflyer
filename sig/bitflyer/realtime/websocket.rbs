module Bitflyer
  module Realtime
    class WebSocketClient
      interface _ChannelNames
        def each: () -> Enumerator[Symbol, self]
                | () { (Symbol) -> void } -> self
        def map: [T] () { (Symbol) -> T } -> Array[T]
               | () -> Enumerator[Symbol, Array[untyped]]
        def include?: (Symbol channel_name) -> bool
        def []: (int index) -> Symbol?
              | (int start, int length) -> Array[Symbol]?
              | (Range[Integer?] range) -> Array[Symbol]?
        def empty?: () -> bool
        def length: () -> Integer
        def size: () -> Integer
      end

      interface _ChannelCallbacks
        def each: () -> Enumerator[[Symbol, message_callback], self]
                | () { ([Symbol, message_callback]) -> void } -> self
        def each_pair: () -> Enumerator[[Symbol, message_callback], self]
                     | () { ([Symbol, message_callback]) -> void } -> self
        def map: [T] () { ([Symbol, message_callback]) -> T } -> Array[T]
               | () -> Enumerator[[Symbol, message_callback], Array[untyped]]
        def []: (Symbol channel_name) -> message_callback?
        def fetch: (Symbol channel_name) -> message_callback
                 | [T] (Symbol channel_name, T default) -> (message_callback | T)
        def key?: (Symbol channel_name) -> bool
        def keys: () -> Array[Symbol]
        def values: () -> Array[message_callback]
        def empty?: () -> bool
        def length: () -> Integer
        def size: () -> Integer
      end

      attr_reader websocket_client: Transport?
      def channel_names: () -> _ChannelNames
      def channel_callbacks: () -> _ChannelCallbacks
      attr_accessor ping_interval: Integer?
      attr_accessor ping_timeout: Integer?
      attr_accessor last_ping_at: Integer?
      attr_accessor last_pong_at: Integer?
      attr_accessor ready: ready_callback?
      attr_accessor disconnected: disconnected_callback?
      attr_accessor subscription_failed: subscription_failed_callback?

      def initialize: (host: String, key: String?, secret: String?, ?debug: bool) -> void

      def shutdown: () -> void

      def inspect: () -> String

      def subscribe: (channel_name: Symbol) { (untyped message) -> void } -> void

      def order_book: (product_code: String) -> OrderBook

      def unsubscribe: (channel_name: Symbol) -> void

      def connect: () -> void

      def send_ping: () -> void

      def wait_pong: () -> void

      def reconnect: () -> void

      def handle_error: (error: untyped) -> void

      def handle_message: (payload: untyped, ?socket: Transport?) -> void

      def handle_close: (error: untyped, ?socket: Transport?, ?complete_close: (^() -> void)?) -> void

      def setup_by_response: (json: String, ?socket: Transport?) -> void

      def authenticate: (?socket: Transport?) -> void

      def authenticated: (json: String, ?socket: Transport?) -> void

      def authentication_succeeded?: (String json) -> bool

      def subscribe_channels: (?socket: Transport?, ?authenticated: bool) -> void

      def acknowledge_subscription: (id: Integer, json: String, ?socket: Transport?) -> void

      def receive_pong: (?socket: Transport?) -> void

      def disconnect: (?socket: Transport?) -> void

      def emit_message: (json: String, ?socket: Transport?) -> void

      def debug_log: (untyped message) -> void
    end
  end
end
