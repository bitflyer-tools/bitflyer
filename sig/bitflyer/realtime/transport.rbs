module Bitflyer
  module Realtime
    class Transport
      HANDSHAKE_TIMEOUT: Integer
      MAX_MESSAGE_SIZE: Integer
      READ_SIZE: Integer
      WRITE_TIMEOUT: Integer

      attr_reader url: String?
      attr_reader thread: Thread?

      def self.default_ssl_context: () -> OpenSSL::SSL::SSLContext

      def initialize: (?ssl_context: OpenSSL::SSL::SSLContext?) -> void

      def connect: (String url) -> void

      def on: (Symbol event) { (untyped, ?^() -> void) -> void } -> void

      def closed?: () -> bool

      def open?: () -> bool

      def send: (String data) -> bool

      def close: () -> void

      def close_for_shutdown: () -> void

      def write: (String data) -> Integer
    end
  end
end
