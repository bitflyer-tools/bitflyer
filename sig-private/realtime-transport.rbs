module Bitflyer
  module Realtime
    class Transport
      @socket: (OpenSSL::SSL::SSLSocket | TCPSocket)?
      @close_state: (:closing | :closed)?
      @driver: WebSocket::Driver?
      @driver_lock: Mutex
      @close_lock: Mutex
      @handlers: Hash[Symbol, ^(untyped, ?^() -> void) -> void]
      @events: Array[[Symbol, untyped]]

      def reconnectable?: () -> bool

      private

      def setup_driver: () -> WebSocket::Driver

      def connect_tls: (URI::Generic) -> (OpenSSL::SSL::SSLSocket | TCPSocket)

      def read_messages: () -> void

      def read_handshake: (OpenSSL::SSL::SSLSocket | TCPSocket) -> void

      def parse: (String) -> void

      def terminate: (?untyped error, ?notify: bool) -> void
    end

    class WebSocketClient
      CONNECTION_TIMEOUT: Integer
      SESSION_RESPONSE_TIMEOUT_MS: Integer
      CALLBACK_QUEUE_LIMIT: Integer
      SUBSCRIPTION_ACK_TIMEOUT_MS: Integer
      RECONNECT_BASE_DELAY: Float
      RECONNECT_MAX_DELAY: Float

      @subscription_tokens: Hash[Symbol, Object]
      type callback_event = [Symbol?, Object?, untyped, Transport?]

      @callback_queue: Array[callback_event]
      @callback_transport: Transport?
      @callback_wakeup: Thread::ConditionVariable
      @callback_worker: Thread?
      @connection: [Transport, Thread]?
      @subscription_ack_deadline: Integer?
      @shutdown_lock: Mutex
      @session_deadline: [Integer, :setup | :authentication] | :expired | :established | nil
      @subscription_frames: Array[[Transport?, String]]
      @subscription_writer: Mutex

      private

      def initialize_callbacks: () -> void

      def enqueue_callback: (Symbol channel, Object? token, untyped message, Transport? socket) -> void

      def enqueue_notification: (Transport? socket) { () -> void } -> void

      def push_callback: (callback_event) -> void

      def deliver_callbacks: () -> void

      def next_callback_event: () -> callback_event?

      def deliver_callback: (Symbol? channel, Object? token, untyped message, Transport? socket) -> void

      def active_callback_transport?: (Transport? socket) -> bool

      def subscribed_callback: (Symbol channel, Object? token) -> (^(untyped) -> void)?

      def stop_callbacks: () -> void

      def retry_pending?: () -> bool

      def queue_subscription: (Symbol, ?setup: bool) -> void

      def queue_subscription_frame: (String) -> void

      def send_subscription_frames: () -> void

      def take_subscription_frame: () -> [Transport?, String]?

      def setup_subscriptions_acknowledged?: () -> bool
      def setup_subscriptions_pending?: () -> bool

      def close_expired_subscriptions: () -> void

      def expire_runtime_subscriptions: (Transport socket) -> void

      def notify_subscription_failure: (Transport? socket, Symbol channel, untyped error) -> void

      def close_connections: () -> void

      def accept_authentication_response: (Transport? socket) -> bool

      def apply_setup: (untyped body, Transport? socket) -> bool

      def awaiting_setup?: ([Integer, :setup | :authentication] | :expired | :established | nil) -> bool

      def authentication_deadline: () -> [Integer, :authentication]?

      def initialize_heartbeat: (untyped body) -> void

      def session_expired?: (Transport socket) -> bool

      def session_deadline_elapsed?: ([Integer, :setup | :authentication] deadline) -> bool

      def stop_lifecycle: () -> [Transport?, [Transport, Thread]?]

      def start_connection: () -> [Transport, Thread]?

      def connection_established?: ([Transport, Thread]) -> bool

      def register_transport_handlers: (Transport) -> void

      def activate_transport: (Transport) -> void

      def replace_transport: (Transport) -> void

      def finish_connection: ([Transport, Thread], bool connected) -> void
    end
  end
end
