module Bitflyer
  module Realtime
    class Transport < WebSocket::Client::Simple::Client
      READ_SIZE: Integer
      HEADER_END: String

      @url: String
      @thread: Thread?
      @handshake: ::WebSocket::Handshake::Client
      @handshaked: bool
      @socket: (TCPSocket | OpenSSL::SSL::SSLSocket)?
      @pipe_broken: bool
      @closed: bool?

      attr_reader read_error: (Errno::ECONNRESET | OpenSSL::SSL::SSLError)?

      def close_after_read_error: (Errno::ECONNRESET | OpenSSL::SSL::SSLError) -> void

      def close_after_write_reset: (Errno::ECONNRESET) -> void

      def close_for_shutdown: () -> void

      private

      def connect_socket: (URI::Generic, Hash[Symbol, untyped]) -> (TCPSocket | OpenSSL::SSL::SSLSocket)
      def ssl_context: (Hash[Symbol, untyped]) -> OpenSSL::SSL::SSLContext
      def receive_frames: ((TCPSocket | OpenSSL::SSL::SSLSocket)) -> void
      def once: (Symbol) { (untyped) -> void } -> void
      def process_chunk: (String, ::WebSocket::Frame::Incoming::Client, String) -> void
      def read_chunk: ((TCPSocket | OpenSSL::SSL::SSLSocket)) -> String?
      def receive_upgrade: (String, String) -> String?
      def deliver_frames: (::WebSocket::Frame::Incoming::Client, String) -> void
      def close_from_reader: () -> void
    end

    class WebSocketClient
      HANDSHAKE_TIMEOUT_MS: Integer

      @connection: [Transport, Thread]?
      @handshake_deadline: Integer?
      @expiring_handshake: bool?
      @shutdown_lock: Mutex

      private

      def close_expired_handshake: () -> void

      def take_expired_handshake: () -> Transport?

      def pending_handshake?: (Transport) -> bool

      def close_connections: () -> void

      def write_ping: (WebSocket::Client::Simple::Client? socket) -> bool

      def close_after_ping_reset: (WebSocket::Client::Simple::Client? socket, Errno::ECONNRESET) -> void

      def close_after_pong_timeout: (WebSocket::Client::Simple::Client? socket) -> void

      def heartbeat_interrupted?: (WebSocket::Client::Simple::Client? socket) -> bool

      def stop_lifecycle: () -> [WebSocket::Client::Simple::Client?, [Transport, Thread]?]

      def start_connection: () -> [Transport, Thread]?

      def wait_for_connection: ([Transport, Thread]) -> bool

      def register_transport_handlers: (Transport) -> void

      def activate_transport: (Transport) -> void

      def replace_transport: (Transport) -> void

      def finish_connection: ([Transport, Thread], bool connected) -> void
    end
  end
end

module WebSocket
  def self.should_raise=: (bool) -> bool

  module Handshake
    class Client
      def initialize: (url: String, headers: untyped) -> void
      def <<: (String) -> untyped
    end
  end

  module Frame
    class Incoming
      class Client
        def <<: (String) -> untyped
        def next: () -> Client?
      end
    end
  end
end
