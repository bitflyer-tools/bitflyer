module Bitflyer
  module Realtime
    class Transport < WebSocket::Client::Simple::Client
      @socket: (TCPSocket | OpenSSL::SSL::SSLSocket)?
      @pipe_broken: bool
      @closed: bool?

      attr_reader reset_error: Errno::ECONNRESET?

      def close_after_reset: (Errno::ECONNRESET) -> void

      def close_for_shutdown: () -> void

      def close_on_eof: () -> void

      private

      def close_from_reader: () -> void
    end

    class WebSocketClient
      @connection: [Transport, Thread]?

      private

      def write_ping: (WebSocket::Client::Simple::Client? socket) -> bool

      def ping_interrupted?: (WebSocket::Client::Simple::Client? socket) -> bool

      def stop_lifecycle: () -> [WebSocket::Client::Simple::Client?, [Transport, Thread]?]

      def start_connection: () -> [Transport, Thread]?

      def register_transport_handlers: (Transport) -> void

      def activate_transport: (Transport) -> void

      def replace_transport: (Transport) -> void

      def finish_connection: ([Transport, Thread], bool connected) -> void
    end
  end
end
