# Minimal signatures for websocket-client-simple, which ships no RBS.
module WebSocket
  module Client
    module Simple
      def self.connect: (String url, ?Hash[Symbol, untyped] options) -> Client

      class Client
        def on: (Symbol event) { (untyped) -> void } -> void

        def send: (String data, ?Hash[Symbol, untyped] options) -> void

        def open?: () -> bool

        def close: () -> void
      end
    end
  end
end
