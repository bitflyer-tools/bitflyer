module Bitflyer
  module Realtime
    class SubscriptionRegistry
      ACK_TIMEOUT_MS: Integer

      @log: realtime_logger
      @subscription_writer: Mutex
      @channel_callbacks: Hash[Symbol, message_callback]
      @subscription_tokens: Hash[Symbol, Object]
      @next_subscription_id: Integer
      @last_setup_subscription_id: Integer
      @pending_setup_subscription_count: Integer
      @pending_subscription_ids: Hash[Symbol, Integer]
      @pending_subscriptions: Hash[Integer, [Symbol, (:queued | Integer | nil)]]
      @acknowledged_subscriptions: Hash[Symbol, bool]
      @subscription_rejected: bool
      @subscription_ack_deadline: Integer?
      @subscription_frames: Array[[Transport?, String, Integer?]]

      attr_reader lock: Mutex

      def initialize: (realtime_logger) -> void
      def reset: () -> void
      def channels: () -> Array[Symbol]
      def callbacks: () -> WebSocketClient::_ChannelCallbacks
      def register: (Symbol, message_callback) -> void
      def unregister?: (Symbol) -> bool
      def acknowledged?: (Symbol) -> bool
      def token: (Symbol) -> Object?
      def callback: (Symbol, Object?) -> message_callback?
      def setup: (Array[Symbol], Transport?) -> void
      def acknowledge: (Integer, String) -> ([Symbol, untyped] | :expired)?
      def expire_runtime_subscriptions: () -> Array[Symbol]
      def queue_subscription: (Symbol, Transport?) -> void
      def cancel_subscription: (Symbol, Transport?, bool) -> void
      def flush: () -> void
      def expire_setup_subscriptions: () -> boolish
      def setup_acknowledged?: () -> bool

      private

      def take_subscription_frame: () -> [Transport?, String]?
      def begin_subscription_dispatch?: (Integer) -> bool
      def record_subscription_result: (Integer, Symbol, untyped) -> void
      def remove_pending_subscription: (Symbol) -> void
      def setup_subscriptions_pending?: () -> bool
      def monotonic_milliseconds: () -> Integer
    end

    class SubscriptionSession
      extend Forwardable

      @connection: ConnectionLifecycle
      @registry: SubscriptionRegistry
      @feeds: OrderBookFeeds
      @dispatcher: CallbackDispatcher
      @log: realtime_logger
      @notifications: SubscriptionNotifications
      @session_authenticated: bool
      @session_ready: bool

      attr_accessor ready: ready_callback?
      attr_accessor subscription_failed: subscription_failed_callback?

      def initialize: (ConnectionLifecycle, SubscriptionRegistry, OrderBookFeeds, CallbackDispatcher, realtime_logger) -> void
      def before_start: [T] () { () -> T } -> T?
      def channel_names: () -> Array[Symbol]
      def channel_callbacks: () -> WebSocketClient::_ChannelCallbacks
      def subscribe: (channel_name: Symbol) { (untyped) -> void } -> void
      def order_book: (product_code: String) -> OrderBook
      def unsubscribe: (channel_name: Symbol) -> void
      def subscribe_channels: (?socket: Transport?, ?authenticated: bool) -> void
      def acknowledge_subscription: (id: Integer, json: String, ?socket: Transport?) -> void
      def expire: (Transport) -> void
      def subscribed_callback: (Symbol, Object?, Transport?) -> message_callback?
      def deliver: (Symbol, Array[untyped], Transport?) -> void
      def reset_for: (Transport?, ?replacement: bool) { () -> void } -> bool

      private

      def reset: () -> void
      def expire_runtime_subscriptions: (Transport) -> void
      def registered_channels: () -> Array[Symbol]
      def message_token: (Symbol, Array[untyped], Transport?) -> Object?
      def callback_channel_ready?: (Symbol) -> bool
      def close_subscription_timeout: (Transport?) -> void
      def notify_ready: (Transport?) -> void
    end

    class SubscriptionNotifications
      @dispatcher: CallbackDispatcher
      @state: :pending | :ready | :notified

      attr_reader ready: ready_callback?
      attr_accessor subscription_failed: subscription_failed_callback?

      def initialize: (CallbackDispatcher) -> void
      def reset: () -> void
      def register_ready: (ready_callback?, Transport?) -> ready_callback?
      def mark_ready: (Transport?) { () -> void } -> ready_callback?
      def enqueue_ready: (Transport?, ready_callback?) -> void
      def failure: (Transport?, Symbol, untyped) -> void

      private

      def take_ready: (Transport?) -> ready_callback?
    end

    class OrderBookFeeds
      @books: Hash[String, OrderBook]
      @feeds: Hash[Symbol, [Method, Symbol]]

      def initialize: () -> void
      def channels: () -> Array[Symbol]
      def include?: (Symbol) -> bool
      def invalidate: () -> void
      def register: (String) -> [OrderBook, Symbol, Symbol]
      def route: (Symbol, Array[untyped]) { (Symbol) -> bool } -> void

      private

      def register_order_book: (Symbol, Symbol) -> OrderBook
    end

    class CallbackDispatcher
      CALLBACK_QUEUE_LIMIT: Integer
      CALLBACK_PAYLOAD_LIMIT: Integer
      FAILURE_NOTIFICATION_QUEUE_LIMIT: Integer
      FAILURE_NOTIFICATION_PAYLOAD_LIMIT: Integer

      type callback_event = [Integer, Symbol?, Object?, untyped, Transport?]
      type callback_kind = :market_data | :ready | :subscription_failed

      @lock: Mutex
      @resolve_callback: ^(Symbol, Object?, Transport?) -> message_callback?
      @callback_queue: Array[[callback_kind, callback_event]]
      @pending_callback_counts: Hash[callback_kind, Integer]
      @pending_callback_bytes: Integer
      @pending_failure_bytes: Integer
      @callback_transport: Transport?
      @callback_wakeup: Thread::ConditionVariable
      @callback_worker: Thread?
      @disconnect_worker: Thread?
      @pending_disconnect: [untyped, disconnected_callback]?
      @pending_authentication_error: RuntimeError?
      @stopped: bool?

      attr_accessor disconnected: disconnected_callback?

      def initialize: (Mutex) { (Symbol, Object?, Transport?) -> message_callback? } -> void
      def reset: (?Transport?) -> void
      def stop: () -> void
      def enqueue_callback: (Symbol, Object, untyped, Transport?) -> void
      def enqueue_notification: (Transport?, :ready | :subscription_failed, ?bytes: Integer) { () -> void } -> void
      def discard_channel_callbacks: (Symbol) -> void
      def notify_authentication_failure: (RuntimeError) -> void
      def dispatch_disconnected: (untyped, ?disconnected_callback?) -> void

      private

      def push_callback: (callback_kind, callback_event) -> void
      def adjust_payload_bytes: (callback_kind, Integer) -> void
      def deliver_callbacks: () -> void
      def next_callback_event: () -> callback_event?
      def deliver_callback: (Symbol?, Object?, untyped, Transport?) -> void
      def active_callback_transport?: (Transport?) -> boolish
      def clear_callback_queue: () -> void
      def deliver_disconnects: ([untyped, disconnected_callback]? notification) -> void
      def next_disconnect_notification: () -> [untyped, disconnected_callback]?
      def notify_disconnected: (untyped, disconnected_callback) -> void
    end
  end
end
